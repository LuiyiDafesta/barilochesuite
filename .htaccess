DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Permitir acceso directo a scripts PHP (upload.php, contact.php, etc)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_FILENAME} \.php$ [NC]
  RewriteRule ^ - [L]

  # Servir archivos o directorios existentes directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirigir todas las demás rutas dinámicas a index.html en el directorio actual
  RewriteRule ^ index.html [L]
</IfModule>

# Compresión GZIP / Deflate
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# Caché de archivos estáticos
<IfModule mod_headers.c>
  <FilesMatch "\.(ico|jpe?g|png|gif|swf|css|js|svg|woff2?)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>
